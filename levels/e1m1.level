# E1M1 — Underground Processing Plant
# =====================================

spawn 0 0 3 0

# --- Environment: underground, so no sun (saves a shadow ray per pixel);
# thick brown fog from 8 m, fully opaque by 22 m ---
ambient 0.04
sun 0.5 1 -0.3 1 0.95 0.7 0
fog 8 22 0.04 0.03 0.02
# Low drone everywhere; concrete gives a little echo
ambience drone
reverb 0.2

# --- Materials (darker, grittier) ---
material concrete    concrete     0.3 0.25 0.2
material dark_metal  metal_panel  0.2 0.2 0.22
material rust_wall   rust         0.4 0.2 0.1
material grate       metal_grate  0.3 0.3 0.3
material brick       brick        0.35 0.25 0.18
material floor_tile  floor_tile   0.25 0.22 0.18
material pipe_mat    pipe         0.3 0.3 0.32
# Animated: slime flows and glows, screens flicker (motion comes with the texture)
material nukage      slime        0.4 0.9 0.3
material monitor     screen       1 1 1

# =====================
# Main Hall
# =====================
room -15 0 -20 15 4 5 concrete floor_tile concrete

# --- Pillars ---
box -1 0 -6 1 2 -4 dark_metal
box 4 0 -8 5.5 3 -6.5 dark_metal
box -6 0 -4 -4.5 1.5 -2.5 dark_metal
box -3 0 -12 -1 4 -10 brick
box 2 0 -14 4 2.5 -12 brick

# --- Walls ---
box -15 0 -20 -14 4 5 brick
box 14 0 -20 15 4 5 brick
box -15 0 -20 15 4 -19 concrete

# --- Steps near right wall ---
box 6 0 -3 10 0.5 -1 dark_metal
box 7 0 -3 10 1.0 -1 dark_metal
box 8 0 -3 10 1.5 -1 dark_metal

# =====================
# Side Corridor (west) — plain door; the blue keycard is inside
# =====================
box -14 0 -12.2 -8 4 -12 rust_wall
box -14 0 -4 -8 4 -3.8 rust_wall
box -8 0 -12.2 -7.8 4 -9 rust_wall
box -8 0 -7 -7.8 4 -3.8 rust_wall
box -8 2.5 -9 -7.8 4 -7 rust_wall
box -14 3 -12 -8 3.2 -4 concrete
brush func_door -7.95 0 -9 -7.85 2.5 -7 dark_metal
brush trigger_once -7.5 0 -9 -6.5 2 -7 message="Something scratches behind the door"
# Rot: darker, with a thick green haze while you're inside
zone -14 0 -12 -7.8 3 -4 ambient=0.02 fog="3 11 0.04 0.06 0.025" ambience=drip reverb=0.5

# Pipe running along ceiling
box -14 2.5 -11 -9 2.8 -10.7 pipe_mat
box -14 2.5 -5.3 -9 2.8 -5 pipe_mat

# Grate floor section, and a seep of glowing slime by the wall
box -13 0.01 -9 -10 0.02 -7 grate
box -13.9 0.01 -11.8 -12.2 0.03 -10.6 nukage
brush trigger_hurt -13.9 0 -11.8 -12.2 0.5 -10.6 damage=5

# =====================
# Storage Room (east) — blue door; its button opens the exit gate
# =====================
box 8 0 -12.2 14 4 -12 dark_metal
box 8 0 -5 14 4 -4.8 dark_metal
box 7.8 0 -12.2 8 4 -9 dark_metal
box 7.8 0 -7 8 4 -4.8 dark_metal
box 7.8 2.5 -9 8 4 -7 dark_metal
box 8 3.5 -12 14 3.7 -5 dark_metal
# Machinery hums in here; metal walls keep it close
zone 8 0 -12 14 3.5 -5 ambience=hum reverb=0.1
brush func_door 7.85 0 -9 7.95 2.5 -7 dark_metal key=blue
brush func_button 13.8 1.0 -8.2 14 1.4 -7.8 rust_wall opens=side rot=-1.5708 lip=0.05 wait=-1 target=lockdown message="Somewhere a gate grinds open"

# Crates
box 9 0 -11 10.5 1.5 -9.5 rust_wall
box 10.5 0 -10 12 1 -8.5 rust_wall
box 12.5 0 -11 14 2 -9 rust_wall
# Secret: a stash on top of the tall crate (climb the low one first)
brush trigger_secret 9 1.5 -11 10.5 3 -9.5
# A monitor above the crates, still on
box 13.9 2.1 -10.5 14 2.7 -9.5 monitor

# =====================
# Back Passage — gate opened only by the storage button
# =====================
box -6 0 -15 -1 4 -14.8 brick
box 1 0 -15 6 4 -14.8 brick
box -1 2.5 -15 1 4 -14.8 brick
box -6.2 0 -19 -6 4 -14.8 brick
box 6 0 -19 6.2 4 -14.8 brick
box -6 3 -19 6 3.2 -15 concrete
brush func_door -1 0 -14.95 1 2.5 -14.85 dark_metal targetname=lockdown wait=-1
# The exit glows through a red haze
zone -6 0 -19 6 3 -14.8 fog="3 14 0.08 0.01 0.01" reverb=0.45

# =====================
# Entities
# =====================
entity health 3 0.5 -3 amount=25
entity health -5 0.5 -8 amount=50
entity ammo -2 0.5 -2 amount=10
# Pickups in storage room
entity ammo 11 0.5 -7 amount=15
entity health 13 0.5 -7 amount=25
entity health 9.75 2.0 -10.25 amount=50
# Weapons and their ammo
entity weapon -2 0.5 1 give=shotgun amount=8
entity ammo -12 0.5 -10 ammo=shells amount=8
entity weapon 9.5 0.5 -6 give=launcher amount=5
entity ammo 11 0.5 -11.5 ammo=rockets amount=5
# Toxic barrels (sprites)
entity decor 1.5 0 -1 w=0.7 h=0.9
entity decor -3.5 0 -6 w=0.7 h=0.9
# Ghouls
entity ghoul 0.5 0 -10
entity ghoul -2 0 -17.5
entity ghoul 12 0 -6.5
entity ghoul -11 0 -6
# Spitters: keep their distance in the long spaces
entity spitter 10 0 -17
entity spitter -13 0 -11
# Ambush: hidden until the storage button is pressed
entity ghoul -10 0 -16 targetname=lockdown
entity ghoul 11 0 -14 targetname=lockdown
# Blue keycard at the far end of the side corridor
entity keycard -12.5 0 -5 color=blue
# Exit pad at the end of the back passage, under a red glow
entity exit 0 0 -18

# =====================
# Lights — sparse, sickly yellow, eerie. Bare bulbs are breakable: shoot
# them out to hide in the dark (enemies still hear you)
# =====================

# Single dim bulb near spawn — off-white yellow
light 0 3.5 1 1.0 0.9 0.5 2.0 15.0 shadows=1 flicker_speed=1.5 flicker_amount=0.1

# Flickering dying bulb near health pickup — harsh yellow
light 3 2.5 -3 1.0 0.8 0.3 1.8 10.0 shadows=1 flicker_speed=7.0 flicker_amount=0.6 breakable=1

# Deep in main hall — single weak sickly light
# It dies when the ambush springs
light -2 3.0 -13 0.9 0.8 0.4 1.5 12.0 shadows=1 flicker_speed=2.5 flicker_amount=0.3 targetname=lockdown

# Bare bulb on a string from the ceiling — slow, subtle swing
light 0 3.0 -8 1.0 0.85 0.4 2.5 13.0 shadows=1 flicker_speed=6.0 flicker_amount=0.2 anchor_x=0 anchor_y=3.95 anchor_z=-8 cord=0.95 swing_speed=0.8 swing_angle=0.15 breakable=1

# Dying fluorescent in back passage — buzzing, unstable
light -1 2.5 -17 0.8 0.9 0.5 1.5 10.0 shadows=1 flicker_speed=12.0 flicker_amount=0.7

# Storage room — single weak bulb, swinging slightly
light 11 2.8 -8 1.0 0.85 0.45 1.8 12.0 shadows=1 flicker_speed=4.0 flicker_amount=0.35 anchor_x=11 anchor_y=3.3 anchor_z=-8 cord=0.5 swing_speed=0.8 swing_angle=0.15 breakable=1

# Exit — low red glow over the pad
light 0 1.2 -18 1.0 0.1 0.05 2.0 6.0 flicker_speed=1.0 flicker_amount=0.2

# Side corridor — almost nothing, just a faint glow
light -11 2.2 -8 0.9 0.8 0.4 1.2 8.0 shadows=1 flicker_speed=3.0 flicker_amount=0.5
